# Firebase Configuration
# Get these values from your Firebase project settings
# Firebase Console: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Website Configuration
VITE_SITE_URL=https://hackethos4u.com

# Server-only Firebase Admin credentials for the SAME website Firebase project.
# Never prefix these with VITE_. Alternatively use GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-only admin OTP configuration
ADMIN_OTP_EMAILS=
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
